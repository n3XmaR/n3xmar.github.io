
---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getCollection, render } from 'astro:content';

const certificates = (await getCollection('certificates')).sort(
  (a, b) =>
    (b.data.endDate?.getTime() ?? 0) -
    (a.data.endDate?.getTime() ?? 0)
);

const bodies = await Promise.all(
  certificates.map(async (certificate) => ({
    id: certificate.id,
    Content: (await render(certificate)).Content
  }))
);
---

<ArchiveLayout
  title="Certificates"
  description="A few milestones along the way."
>

  <div class="certificate-filters">
    <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
      All
    </button>

    <button type="button" class="filter-btn" data-filter="certification" aria-pressed="false">
      Certifications
    </button>

    <button type="button" class="filter-btn" data-filter="completion" aria-pressed="false">
      Completions
    </button>
  </div>


  <div class="archive-grid certificates-grid">
    {certificates.map((certificate) => (
      <button
        type="button"
        class="certificate-card"
        data-id={certificate.id}
        data-title={certificate.data.title}
        data-issuer={certificate.data.issuer}
        data-image={certificate.data.image}
        data-type={certificate.data.type}
        data-start={certificate.data.startDate?.toLocaleDateString('en-GB', { timeZone: 'UTC' }) ?? ''}
        data-end={certificate.data.endDate?.toLocaleDateString('en-GB', { timeZone: 'UTC' }) ?? ''}
        aria-haspopup="dialog"
      >
        <div class="certificate-image">
          <img
            src={certificate.data.image}
            alt={`${certificate.data.title} certificate`}
            loading="lazy"
          />
        </div>

        
        <h3>{certificate.data.title}</h3>
        <p>{certificate.data.issuer}</p>

        <p class="certificate-meta">
          {certificate.data.type === 'certification'
            ? 'Certification'
            : 'Path Completion'}

          {certificate.data.endDate && (
            <> · {certificate.data.endDate.toLocaleDateString('en-GB', { timeZone: 'UTC' })}</>
          )}
        </p>

      </button>
    ))}
  </div>

  {certificates.length === 0 && (
    <p class="archive-empty">Nothing here yet.</p>
  )}

  {bodies.map(({ id, Content }) => (
    <template id={`certificate-body-${id}`}>
      <Content />
    </template>
  ))}

  <dialog id="certificate-modal" aria-labelledby="modal-title">
    <button
      type="button"
      class="modal-close"
      aria-label="Close certificate"
    >
      ×
    </button>

    <img id="modal-image" src="" alt="" />
    <h3 id="modal-title"></h3>
    <p id="modal-issuer"></p>
    <p id="modal-meta"></p>
    <p id="modal-meta"></p>
    <div id="modal-body" class="certificate-content"></div>
  </dialog>
</ArchiveLayout>


<script>
  const modal = document.querySelector<HTMLDialogElement>(
    '#certificate-modal'
  );

  if (modal) {
    const image = modal.querySelector<HTMLImageElement>('#modal-image');
    const title = modal.querySelector<HTMLElement>('#modal-title');
    const issuer = modal.querySelector<HTMLElement>('#modal-issuer');
    const meta = modal.querySelector<HTMLElement>('#modal-meta');
    const body = modal.querySelector<HTMLElement>('#modal-body');

    document.querySelectorAll<HTMLButtonElement>(
      '.archive-grid .certificate-card'
    ).forEach((card) => {
      card.addEventListener('click', () => {
        if (!image || !title || !issuer || !meta || !body) return;

        image.src = card.dataset.image ?? '';
        image.alt = `${card.dataset.title ?? 'Certificate'} certificate`;

        title.textContent = card.dataset.title ?? '';
        issuer.textContent = card.dataset.issuer ?? '';

        const { type, start, end } = card.dataset;

        meta.textContent = [
          type === 'certification' ? 'Certification' : 'Path Completion',
          start && end
            ? `${start} – ${end}`
            : end
              ? `Completed: ${end}`
              : start
                ? `Started: ${start}`
                : ''
        ].filter(Boolean).join(' · ');

        body.replaceChildren();

        const template = document.getElementById(
          `certificate-body-${card.dataset.id}`
        ) as HTMLTemplateElement | null;

        if (template) {
          body.appendChild(template.content.cloneNode(true));
        }

        modal.scrollTop = 0;
        modal.showModal();
      });
    });

    modal.querySelector('.modal-close')?.addEventListener(
      'click',
      () => modal.close()
    );

    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>



<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(
    '.filter-btn'
  );

  const cards = document.querySelectorAll<HTMLElement>(
    '.archive-grid .certificate-card'
  );

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.filter;

      filters.forEach((filter) => {
        filter.setAttribute(
          'aria-pressed',
          String(filter === button)
        );
      });

      cards.forEach((card) => {
        card.hidden =
          selected !== 'all' &&
          card.dataset.type !== selected;
      });
    });
  });
</script>



<style>
  .certificate-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 9px 15px;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }

  .filter-btn:hover,
  .filter-btn[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .certificate-card[hidden] {
    display: none;
  }
</style>

